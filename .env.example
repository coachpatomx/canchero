# Plantilla de configuración del Agente de Fútbol.
# Copia este archivo a ".env" y rellena tus valores:   cp .env.example .env
# El archivo .env real NO se sube al repositorio (está en .gitignore).
#
# Si dejas todo comentado, el agente funciona en modo determinista (offline, gratis).

# ---- OpenAI (pago por uso; carga saldo de API en platform.openai.com) ----
# AGENTE_LLM_PROVIDER=openai
# AGENTE_LLM_MODEL=gpt-4o-mini
# AGENTE_LLM_API_KEY_VAR=OPENAI_API_KEY
# OPENAI_API_KEY=sk-pega-tu-clave-real-aqui

# ---- Anthropic (Claude) ----
# AGENTE_LLM_PROVIDER=anthropic
# AGENTE_LLM_MODEL=claude-3-5-haiku-latest
# AGENTE_LLM_API_KEY_VAR=ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Ollama (local, gratis, offline; instala Ollama aparte) ----
# AGENTE_LLM_PROVIDER=ollama
# AGENTE_LLM_MODEL=llama3

# ---- Cadena de respaldo (usa el primero disponible) ----
# AGENTE_LLM_PROVIDER=chain
# AGENTE_LLM_CHAIN=ollama,openai
# AGENTE_LLM_MODEL=gpt-4o-mini
# AGENTE_LLM_API_KEY_VAR=OPENAI_API_KEY
# OPENAI_API_KEY=sk-...
